# タイムゾーン
TZ=Asia/Tokyo

# PostgreSQL 管理者設定値 (初期化用スーパーユーザー)
POSTGRES_DB=app_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=secure_admin_password_please_change

# PostgreSQL アプリケーション接続用非特権ユーザー
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=secure_app_password_please_change

# Neo4j 設定値 (フォーマット: ユーザー名/パスワード)
NEO4J_AUTH=neo4j/secure_password_please_change

# ルーティングに使用するドメイン
DOMAIN=app.localhost

