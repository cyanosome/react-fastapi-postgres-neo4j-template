# ローカル開発用オーバーライド設定例
# 使用方法: cp compose.override.yaml.sample compose.override.yaml
# `docker compose up` 実行時に自動的に適用され、ホットリロード環境が有効になります。

services:
  backend:
    volumes:
      - ./backend:/backend_app
      - /backend_app/.venv
    command: ["uv", "run", "fastapi", "dev", "main.py", "--host", "0.0.0.0", "--port", "8000"]

  frontend:
    build:
      target: development
    volumes:
      - ./frontend:/frontend_app
      - /frontend_app/node_modules
    command: ["npm", "run", "dev", "--", "--host"]
    labels:
      - "traefik.http.services.frontend.loadbalancer.server.port=5173"
