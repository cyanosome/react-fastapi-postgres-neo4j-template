# 共通タイムゾーン
TZ=Asia/Tokyo

# ルーティングに使用するドメイン
# ローカル開発時: app.localhost (hostsファイル編集不要)
# 本番デプロイ時: yourdomain.com などの本番用ドメインを指定
DOMAIN=app.localhost

# Traefikダッシュボードのベーシック認証設定 (ユーザー名:htpasswdハッシュ)
# アクセス先: http://traefik.app.localhost (または http://traefik.yourdomain.com)
# 生成例: echo $(htpasswd -nb admin yourpassword) | sed -e s/\\$/\\$\\$/g
DASHBOARD_AUTH=admin:$$apr1$$W8J7u6t5$$UjW3nx37829...

